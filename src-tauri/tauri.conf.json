{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetBender",
  "version": "0.0.10",
  "identifier": "com.assetbender.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AssetBender",
        "width": 900,
        "height": 710,
        "minWidth": 900,
        "minHeight": 710,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nameapp"
        ]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/cuonglamphu/Assetbender-DesktopApp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEM0IxRjREMjA3NTJEQUUKUldTdUxYVWdUUjg3dlFpMFAxOUQwcWpNYm4va1RmSnJyOFlGWHBidXJZNkU2dElzY3dLb2JXU3QK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
