# Optional overrides (defaults match production AssetBender).
VITE_API_URL=https://api.assetbender.com
VITE_FRONTEND_URL=https://assetbender.com
# VITE_FRONTEND_URL=http://localhost:3002
VITE_SOCKET_URL=wss://api.assetbender.com

# Rust (tauri dev / build) — optional
# ASSETBENDER_API_URL=https://api.assetbender.com
# ASSETBENDER_FRONTEND_URL=https://assetbender.com
# ASSETBENDER_SOCKET_URL=wss://api.assetbender.com

# Đường dẫn tới private key (hoặc nội dung key); file đã gitignore — không commit.
TAURI_SIGNING_PRIVATE_KEY=.tauri/updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=123123